# Interswitch Configuration Template
# Copy this to your .env.local file and update with your credentials

# ================================
# Interswitch Web Checkout (Frontend)
# ================================

# Your Interswitch merchant code
# Get from: https://business.quickteller.com → Developer Tools → Credentials
VITE_INTERSWITCH_MERCHANT_CODE=MX6072

# Your Interswitch pay item ID
# Create a pay item in Quickteller Business and copy its ID
VITE_INTERSWITCH_PAY_ITEM_ID=101007

# Set to 'true' for production, 'false' for testing
# Always use 'false' during development
VITE_INTERSWITCH_LIVE=false

# ================================
# Supabase Server Configuration
# ================================

# Your Supabase project URL
# Get from: https://app.supabase.com → Project Settings → API
SUPABASE_URL=https://your-project.supabase.co

# Supabase service role key (backend only, keep secret!)
# Get from: https://app.supabase.com → Project Settings → API
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Supabase anonymous key (frontend safe)
# Get from: https://app.supabase.com → Project Settings → API
SUPABASE_ANON_KEY=eyJhbGciOi...

# ================================
# Interswitch Backend Configuration
# ================================

# Same as VITE_INTERSWITCH_MERCHANT_CODE
INTERSWITCH_MERCHANT_CODE=MX6072

# Same as VITE_INTERSWITCH_PAY_ITEM_ID
INTERSWITCH_PAY_ITEM_ID=101007

# Same as VITE_INTERSWITCH_LIVE
INTERSWITCH_LIVE=false

# Interswitch webhook secret
# Get from: https://business.quickteller.com → Developer Tools → Webhooks
INTERSWITCH_WEBHOOK_SECRET=your_webhook_secret_key

# ================================
# Application Configuration
# ================================

# Your application's public URL (for redirects)
# During development: http://localhost:5173
# In production: https://yourdomain.com
APP_PUBLIC_URL=http://localhost:5173

# ================================
# Test Credentials (for development only)
# ================================

# Card Number: 5061050000000001
# Expiry: 05/25
# CVV: 999
# PIN: 0000
# OTP: 123456
# These are test credentials and can only be used with INTERSWITCH_LIVE=false
